{
  "servers": [
    {
      "server_id": "web_page_fetch",
      "enabled": true,
      "command": "mcp_servers/web_page_fetch/.venv/Scripts/python.exe",
      "args": ["-B", "-m", "web_page_fetch"],
      "cwd": "mcp_servers/web_page_fetch",

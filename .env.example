DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

DEEPSEEK_BASE_URL=YOUR_DEEPSEEK_BASE_URL

DEFAULT_MODEL=YOUR_DEFAULT_MODEL

# 本地 Embedding 模型路径
# 使用正斜杠避免 Windows 反斜杠转义问题
EMBEDDING_MODEL_PATH=YOUR_EMBEDDING_MODEL_PATH

# 本地 Reranker 模型路径
# 使用正斜杠避免 Windows 反斜杠转义问题
RERANKER_MODEL_PATH=YOUR_RERANKER_MODEL_PATH

# 本地PostgreSQL数据库链接配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_agent_platform
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD